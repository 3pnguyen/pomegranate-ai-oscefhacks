{
  "manifest_version": 3,
  "name": "Pomegranate AI",
  "version": "0.1.0",
  "description": "Ai as a tool to facilitate learning, not as a replacement.",
  "author" : "POAI Team",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://openrouter.ai/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["prompts.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { 
    "default_title": "Think First settings",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-diagram": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Screenshot a region (diagram, figure) and explain it"
    }
  }
}
